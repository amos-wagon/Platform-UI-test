{
  "name": "@aspentech/pf-ui-designsystem",
  "version": "0.0.41",
  "main": "dist/main.css",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://artifactory.tools.aspencloud.ai/artifactory/api/npm/pf-npm/"
  },
  "scripts": {
    "build": "npm run build:sprites && npm run build:components && npm run build:elements && npm run build:utilities && npm run lint && npx postcss src/theme/main.css -o dist/main.css",
    "build-storybook": "npm run build && tsx ./node_modules/@aspentech/pf-ui-devutils/dist/scripts/build-storybook.ts",
    "storybook": "npm run build:sprites && npm run lint && storybook dev -p 6007",
    "build:components": "tsx scripts/build-components-css.ts",
    "build:elements": "tsx scripts/build-elements-css.js",
    "build:sprites": "tsx scripts/build-sprites.ts",
    "build:utilities": "tsx scripts/build-utilities-css.ts",
    "lint": "npm run lint:code && npm run lint:css",
    "lint:code": "eslint",
    "lint:css": "stylelint 'src/**/*.{css,scss}'",
    "lint:fix": "npm run lint:code:fix && npm run lint:css:fix && npm run format",
    "lint:code:fix": "eslint --fix",
    "lint:css:fix": "stylelint 'src/**/*.{css,scss}' --fix",
    "format": "prettier --write --cache ./src",
    "format:check": "prettier --check --cache ./src"
  },
  "devDependencies": {
    "@aspentech/pf-ui-devutils": "0.0.11",
    "@eslint/js": "9.33.0",
    "@storybook/addon-docs": "9.1.2",
    "@storybook/web-components-vite": "9.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/svg-sprite": "0.0.39",
    "autoprefixer": "10.4.21",
    "cssnano": "7.1.0",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.1.1",
    "eslint-plugin-perfectionist": "4.15.0",
    "eslint-plugin-sonarjs": "3.0.4",
    "eslint-plugin-storybook": "9.1.2",
    "eslint-plugin-tsdoc": "0.4.0",
    "fs-extra": "^11.3.1",
    "globals": "16.3.0",
    "lit": "3.3.1",
    "postcss": "8.5.6",
    "postcss-cli": "11.0.1",
    "postcss-import": "16.1.1",
    "prettier": "3.6.2",
    "remark-gfm": "4.0.1",
    "storybook": "9.1.2",
    "stylelint": "16.23.1",
    "stylelint-config-clean-order": "7.0.0",
    "stylelint-config-standard": "39.0.0",
    "svg-sprite": "2.0.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@material-design-icons/font": "0.14.15",
    "@material-design-icons/svg": "0.14.15",
    "@shoelace-style/shoelace": "2.20.1"
  }
}
